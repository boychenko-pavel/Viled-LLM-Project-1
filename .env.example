OPENAI_API_KEY=

HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/callback
HH_APPLICATION_NAME=ViledATLAS/1.0

# Optional database connection (sqlite default used if unset)
DATABASE_URL=sqlite:///./data.db

# Local olama model name (requires olama binary on PATH)
OLAMA_MODEL=
VOICE_MODEL=small
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8
VOICE_LANGUAGE=ru
# VOICE_MODEL_DIR=C:\path\to\local\faster-whisper\models
